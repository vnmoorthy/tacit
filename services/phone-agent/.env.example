# LiveKit Cloud project (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound SIP trunk id (created once with `lk sip outbound create`, see docs/PHONE.md)
LIVEKIT_SIP_TRUNK_ID=ST_xxxx
LIVEKIT_AGENT_NAME=tacit-interviewer

# Boson AI
BOSON_API_KEY=
BOSON_VOICE=default

# Where the Tacit API is reachable from this worker
TACIT_API_URL=http://localhost:8787
