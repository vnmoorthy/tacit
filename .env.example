# ─────────────────────────────────────────────────────────────
# Tacit — environment
# Everything is optional. With no keys, Tacit runs in Demo Brain
# mode (offline heuristics) and uses your browser's built-in speech.
# ─────────────────────────────────────────────────────────────

# Server
API_PORT=8787
DATABASE_PATH=./data/tacit.db

# ── LLM provider (auto-detected in this order if LLM_PROVIDER is unset)
# nebius | openai | anthropic | ollama | demo
# LLM_PROVIDER=nebius

# Nebius Token Factory (hackathon partner) — OpenAI-compatible
# NEBIUS_API_KEY=
# NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# NEBIUS_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# OpenAI (or any OpenAI-compatible endpoint via OPENAI_BASE_URL)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Ollama (local, free) — used automatically when reachable
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Voice: Boson AI Higgs Realtime (hackathon partner)
# When set, the interview room uses Higgs Realtime speech-to-speech.
# Otherwise the browser's Web Speech API is used (Chrome recommended).
# BOSON_API_KEY=
# BOSON_VOICE=default

# ── Phone interviews (optional): Twilio SIP trunk → LiveKit → Higgs Realtime agent (docs/PHONE.md)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_SIP_TRUNK_ID=ST_xxxx
# LIVEKIT_AGENT_NAME=tacit-interviewer
# Public URL of this API as seen by the phone-agent worker (defaults to the request origin)
# PUBLIC_API_URL=https://tacit.example.com
